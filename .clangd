If:
  OS: linux
CompileFlags:
  CompilationDatabase: build/cmake
  Remove: [-mno-direct-extern-access]

  Add: [
    "-Igui",
    "-Iguihlp/include",
    "-Ibuild/_deps/ads-src/src",
    "-I/usr/include/qt6/QtCore",
    "-I/usr/include/qt6",
    "-isystem", "/usr/include",

    "-std=c++23"
  ]
Index:
  Background: Build

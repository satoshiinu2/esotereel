[
  {
    "label": "Build and debug GUI",
    "adapter": "CodeLLDB",
    "request": "launch",
    "program": "${ZED_WORKTREE_ROOT}/build/cmake/esotereel_gui.exe",
    "cwd": "${ZED_WORKTREE_ROOT}/build/cmake",
    "env": {
      "RUST_BACKTRACE": "1",
      "CARGO_TARGET_DIR": "${ZED_WORKTREE_ROOT}/build/target",
      "ESOTEREEL_PLUGIN_DIR": "${ZED_WORKTREE_ROOT}/plugins",
      "ESOTEREEL_WORKING_DIR": "${ZED_WORKTREE_ROOT}/build/working",
    },
    "build": {
      "command": "cmake",
      "args": ["--build", "build/cmake"],
    },
  },
  {
    "label": "Build and debug CORE",
    "adapter": "CodeLLDB",
    "request": "launch",
    "program": "${ZED_WORKTREE_ROOT}/build/target/debug/esotereel_core.exe",
    "cwd": "${ZED_WORKTREE_ROOT}/build/target/debug",
    "env": {
      "RUST_BACKTRACE": "1",
      "CARGO_TARGET_DIR": "${ZED_WORKTREE_ROOT}/build/target",
      "ESOTEREEL_PLUGIN_DIR": "${ZED_WORKTREE_ROOT}/plugins",
      "ESOTEREEL_WORKING_DIR": "${ZED_WORKTREE_ROOT}/build/working",
    },
    "build": {
      "command": "cmake",
      "args": ["--build", "build/cmake", "--target", "rust_core"],
    },
  },
]

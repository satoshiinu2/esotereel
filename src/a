use winit::{
    event::*,
    event_loop::EventLoop,
    window::{Window, WindowAttributes},
};

use egui_winit::State as EguiWinitState;

fn main() {
    let event_loop = EventLoop::new().unwrap();

    let mut window: Option<Window> = None;

    // egui
    let egui_ctx = egui::Context::default();
    let mut egui_state = None;

    // wgpu
    let mut renderer = None;
    let mut surface = None;
    let mut device = None;
    let mut queue = None;
    let mut config = None;

    event_loop
        .run(move |event, elwt| {
            match event {
                Event::Resumed => {
                    // window作成
                    if window.is_none() {
                        let attrs = WindowAttributes::default()
                            .with_title("wgpu + egui")
                            .with_inner_size(winit::dpi::LogicalSize::new(800, 600));

                        let win = elwt.create_window(attrs).unwrap();

                        // wgpu初期化
                        let instance = wgpu::Instance::default();
                        let surf = unsafe { instance.create_surface(&win) }.unwrap();

                        let adapter = pollster::block_on(instance.request_adapter(
                            &wgpu::RequestAdapterOptions {
                                compatible_surface: Some(&surf),
                                ..Default::default()
                            },
                        ))
                        .unwrap();

                        let (dev, q) = pollster::block_on(
                            adapter.request_device(&wgpu::DeviceDescriptor::default(), None),
                        )
                        .unwrap();

                        let size = win.inner_size();

                        let cfg = wgpu::SurfaceConfiguration {
                            usage: wgpu::TextureUsages::RENDER_ATTACHMENT,
                            format: surf.get_capabilities(&adapter).formats[0],
                            width: size.width,
                            height: size.height,
                            present_mode: wgpu::PresentMode::Fifo,
                            alpha_mode: wgpu::CompositeAlphaMode::Auto,
                            view_formats: vec![],
                        };

                        surf.configure(&dev, &cfg);

                        // egui renderer
                        let rend = egui_wgpu::Renderer::new(&dev, cfg.format, None, 1);

                        egui_state = Some(EguiWinitState::new(&event_loop));
                        renderer = Some(rend);
                        surface = Some(surf);
                        device = Some(dev);
                        queue = Some(q);
                        config = Some(cfg);
                        window = Some(win);
                    }
                }

                Event::WindowEvent { event, window_id } => {
                    if let Some(win) = &window {
                        if window_id == win.id() {
                            let egui_state = egui_state.as_mut().unwrap();
                            if egui_state.on_event(&egui_ctx, &event).consumed {
                                return;
                            }

                            match event {
                                WindowEvent::CloseRequested => elwt.exit(),

                                WindowEvent::Resized(size) => {
                                    let cfg = config.as_mut().unwrap();
                                    cfg.width = size.width;
                                    cfg.height = size.height;
                                    surface
                                        .as_ref()
                                        .unwrap()
                                        .configure(device.as_ref().unwrap(), cfg);
                                }

                                WindowEvent::RedrawRequested => {
                                    let win = window.as_ref().unwrap();

                                    // egui input
                                    let raw_input =
                                        egui_state.as_mut().unwrap().take_egui_input(win);

                                    // UI
                                    let full_output = egui_ctx.run(raw_input, |ctx| {
                                        egui::CentralPanel::default().show(ctx, |ui| {
                                            ui.label("Hello egui + wgpu!");
                                        });
                                    });

                                    egui_state.as_mut().unwrap().handle_platform_output(
                                        win,
                                        &egui_ctx,
                                        full_output.platform_output,
                                    );

                                    // 描画準備
                                    let paint_jobs = egui_ctx.tessellate(full_output.shapes);

                                    let frame =
                                        surface.as_ref().unwrap().get_current_texture().unwrap();

                                    let view = frame
                                        .texture
                                        .create_view(&wgpu::TextureViewDescriptor::default());

                                    let mut encoder =
                                        device.as_ref().unwrap().create_command_encoder(
                                            &wgpu::CommandEncoderDescriptor::default(),
                                        );

                                    // egui描画
                                    renderer.as_mut().unwrap().update_buffers(
                                        device.as_ref().unwrap(),
                                        queue.as_ref().unwrap(),
                                        &mut encoder,
                                        &paint_jobs,
                                        &egui_wgpu::renderer::ScreenDescriptor {
                                            size_in_pixels: [
                                                config.as_ref().unwrap().width,
                                                config.as_ref().unwrap().height,
                                            ],
                                            pixels_per_point: win.scale_factor() as f32,
                                        },
                                    );

                                    {
                                        let mut rpass = encoder.begin_render_pass(
                                            &wgpu::RenderPassDescriptor {
                                                label: None,
                                                color_attachments: &[Some(
                                                    wgpu::RenderPassColorAttachment {
                                                        view: &view,
                                                        resolve_target: None,
                                                        ops: wgpu::Operations {
                                                            load: wgpu::LoadOp::Clear(
                                                                wgpu::Color::BLACK,
                                                            ),
                                                            store: true,
                                                        },
                                                    },
                                                )],
                                                depth_stencil_attachment: None,
                                            },
                                        );

                                        renderer.as_mut().unwrap().render(
                                            &mut rpass,
                                            &paint_jobs,
                                            &egui_wgpu::renderer::ScreenDescriptor {
                                                size_in_pixels: [
                                                    config.as_ref().unwrap().width,
                                                    config.as_ref().unwrap().height,
                                                ],
                                                pixels_per_point: win.scale_factor() as f32,
                                            },
                                        );
                                    }

                                    queue.as_ref().unwrap().submit(Some(encoder.finish()));
                                    frame.present();
                                }

                                _ => {}
                            }
                        }
                    }
                }

                Event::AboutToWait => {
                    if let Some(win) = &window {
                        win.request_redraw();
                    }
                }

                _ => {}
            }
        })
        .unwrap();
}

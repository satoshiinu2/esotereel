{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build gui debug",
      "type": "shell",
      "command": "cmake -G Ninja -S \"${workspaceFolder}\" -B build/cmake -DCMAKE_BUILD_TYPE=Debug && cmake --build build/cmake",
      "group": "build",
      "dependsOrder": "sequence",
      "windows": {
        "options": {
          "command": "cmake -G \"MinGW Makefiles\" -S \"${workspaceFolder}\" -B build/cmake -DCMAKE_BUILD_TYPE=Debug && cmake --build build/cmake",
          "shell": {
            "executable": "cmd",
            "args": [
              "/c"
            ]
          }
        }
      }
    },
    {
      "label": "build gui release",
      "type": "shell",
      "command": "cmake -G Ninja -S \"${workspaceFolder}\" -B build/cmake -DCMAKE_BUILD_TYPE=Release && cmake --build build/cmake",
      "group": "build",
      "dependsOrder": "sequence",
      "windows": {
        "options": {
          "command": "cmake -G \"MinGW Makefiles\" -S \"${workspaceFolder}\" -B build/cmake -DCMAKE_BUILD_TYPE=Release && cmake --build build/cmake",
          "shell": {
            "executable": "cmd",
            "args": [
              "/c"
            ]
          }
        }
      }
    },
    {
      "label": "build core debug",
      "type": "shell",
      "command": "cmake -G Ninja -S \"${workspaceFolder}\" -B build/cmake -DCMAKE_BUILD_TYPE=Debug && cmake --build build/cmake --target rust_core",
      "group": "build",
      "dependsOrder": "sequence",
      "windows": {
        "options": {
          "command": "cmake -G \"MinGW Makefiles\" -S \"${workspaceFolder}\" -B build/cmake -DCMAKE_BUILD_TYPE=Debug && cmake --build build/cmake --target rust_core",
          "shell": {
            "executable": "cmd",
            "args": [
              "/c"
            ]
          }
        }
      }
    },
    {
      "label": "build core release",
      "type": "shell",
      "command": "cmake -G Ninja -S \"${workspaceFolder}\" -B build/cmake -DCMAKE_BUILD_TYPE=Release && cmake --build build/cmake --target rust_core",
      "group": "build",
      "dependsOrder": "sequence",
      "windows": {
        "options": {
          "command": "cmake -G \"MinGW Makefiles\" -S \"${workspaceFolder}\" -B build/cmake -DCMAKE_BUILD_TYPE=Release && cmake --build build/cmake --target rust_core",
          "shell": {
            "executable": "cmd",
            "args": [
              "/c"
            ]
          }
        }
      }
    }
  ]
}
{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Build and debug GUI",
      "type": "lldb",
      "request": "launch",
      "program": "${workspaceFolder}/build/cmake/esotereel_gui",
      "cwd": "${workspaceFolder}/build/cmake",
      "preLaunchTask": "build gui debug",
      "env": {
        "RUST_BACKTRACE": "1",
        "CARGO_TARGET_DIR": "${workspaceFolder}/build/target"
      }
    },
    {
      "name": "Build and debug CORE",
      "type": "lldb",
      "request": "launch",
      "program": "${workspaceFolder}/build/target/debug/esotereel_core",
      "cwd": "${workspaceFolder}/build/target/debug",
      "preLaunchTask": "build core debug",
      "env": {
        "RUST_BACKTRACE": "1",
        "CARGO_TARGET_DIR": "${workspaceFolder}/build/target"
      }
    }
  ]
}
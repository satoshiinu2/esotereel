{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Build and debug gui",
      "type": "lldb",
      "request": "launch",
      "program": "${workspaceFolder}/build/esotereel_gui",
      "args": [ "${workspaceFolder}/target/debug/esotereel_core" ],
      "cwd": "${workspaceFolder}/build",

      "preLaunchTask": "build debug",

      "env": {
        "RUST_BACKTRACE": "1",
      },
      "windows": {
        "env": {
          "RUST_BACKTRACE": "1",
        }
      },
      "linux": {
        "env": {
          "RUST_BACKTRACE": "1",
          // "QT_QPA_PLATFORM": "xcb"
        }
      }
    }
  ]
}

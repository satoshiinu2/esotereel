{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Build and debug gui",
      "type": "cppdbg",
      "request": "launch",
      "program": "${command:cmake.launchTargetPath}",
      "args": [ "${workspaceFolder}/target/debug/nomyoedit_core" ],
      "cwd": "${workspaceFolder}/build",
      "stopAtEntry": false,

      "MIMode": "gdb",
      "miDebuggerPath": "gdb",

      "externalConsole": false,

      "preLaunchTask": "build debug",
      "setupCommands": [
        {
          "description": "Enable pretty-printing",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ],

      "environment": [
        { "name": "RUST_BACKTRACE", "value": "1" }
      ],
      "windows": {
        "environment": [
          { "name": "RUST_BACKTRACE", "value": "1" }
        ]
      },
      "linux": {
        "environment": [
          { "name": "RUST_BACKTRACE", "value": "1" },
          { "name": "QT_QPA_PLATFORM", "value": "xcb" }
        ]
      }
    }
  ]
}
